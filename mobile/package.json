{
  "name": "morrowfolio-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "start:ios": "expo start --go --lan",
    "ios": "expo run:ios",
    "web": "expo start --web --localhost",
    "prebuild": "expo prebuild --platform ios --no-install",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "gateway": "node scripts/mobile-gateway.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "58.0.26",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "expo-status-bar": "58.0.5",
    "expo-audio": "58.0.12",
    "expo-speech": "58.0.4",
    "expo-secure-store": "58.0.3",
    "expo-file-system": "58.0.14",
    "expo-system-ui": "58.0.7",
    "expo-splash-screen": "58.0.14",
    "react-native-safe-area-context": "5.11.1",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.4",
    "@expo/metro-runtime": "58.0.17"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
