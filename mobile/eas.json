{
  "cli": {
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_PREVIEW": "0", "EXPO_PUBLIC_ALLOW_LOCAL_HTTP": "0" }
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_PREVIEW": "0", "EXPO_PUBLIC_ALLOW_LOCAL_HTTP": "0" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_PREVIEW": "0", "EXPO_PUBLIC_ALLOW_LOCAL_HTTP": "0" }
    }
  },
  "submit": { "production": {} }
}
