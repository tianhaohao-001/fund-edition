# Optional overrides for the local paper simulator. Keep real credentials outside version control.
FUNDROOM_HOST=127.0.0.1
FUNDROOM_PORT=3000
# FUNDROOM_DB_PATH=.fundroom/fundroom-v1.sqlite

# Public demo mode requires a specific origin. It serves synthetic replay only.
FUNDROOM_PUBLIC_DEMO=false
# FUNDROOM_PUBLIC_ORIGIN=https://fundroom.example

# All ordinary conversations use the hosted agent. Offline examples are an explicit Pro action.
FUNDROOM_ENABLE_HARNESS=true
FUNDROOM_DEFAULT_PROVIDER=committee
FUNDROOM_HOURLY_AI_TASKS=100
FUNDROOM_AI_CONCURRENCY=2
# Public hosted Node only. Rolling daily cap for guest manager calls; 0 pauses new guest calls.
FUNDROOM_GUEST_AI_DAILY_LIMIT=80
HARNESSROUTER_BASE_URL=https://api.harnessrouter.ai
HARNESSROUTER_HARNESS_ID=
HARNESSROUTER_API_KEY=
HARNESSROUTER_MODEL=deepseek-v4.1-flash

# Optional on-device speech. setup-voice.ps1 installs Whisper small in the per-user cache.
FUNDROOM_ENABLE_LOCAL_VOICE=true
# FUNDROOM_VOICE_HOME=C:\Users\you\.cache\morrowfolio-voice
# FUNDROOM_VOICE_PYTHON=python

# Optional independent market data and read-only paper account credentials.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Optional single-operator broker console at /broker.html. Each write needs typed confirmation.
# Configure a random base64url operator token of 32 to 128 characters and fresh Alpaca data above.
# FUNDROOM_BROKER_DB_PATH=.fundroom/broker-v1.sqlite
FUNDROOM_BROKER_OPERATOR_TOKEN=
ALPACA_PAPER_TRADING_ENABLED=false
ALPACA_PAPER_TRADING_KEY_ID=
ALPACA_PAPER_TRADING_SECRET_KEY=
ALPACA_PAPER_ALLOWED_SYMBOLS=
ALPACA_PAPER_MAX_ORDER_USD=
ALPACA_LIVE_TRADING_ENABLED=false
ALPACA_LIVE_TRADING_KEY_ID=
ALPACA_LIVE_TRADING_SECRET_KEY=
ALPACA_LIVE_ALLOWED_SYMBOLS=

# Optional Stripe subscription adapter for the HTTPS Node hosting profile.
# Unset mode leaves real checkout disabled. Never mix test and live credentials.
FUNDROOM_STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=

# Optional PayPal subscription adapter, populated by the merchant only.
FUNDROOM_PAYPAL_MODE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# Optional: dedicated PayPal Sandbox Orders v2. These two must belong to the same sandbox app.
# The on-site simulation at /checkout-test.html is also available without credentials.
FUNDROOM_PAYPAL_SANDBOX_CLIENT_ID=
FUNDROOM_PAYPAL_SANDBOX_CLIENT_SECRET=

# One-time membership payment requests. The full Railway launcher enables this by default.
# No merchant secret is needed. Set false to stop accepting new orders.
FUNDROOM_INVOICE_ORDERS=false
# Configure only your confirmed commercial seller profile, or a separate fixed-price reusable PayPal product per term.
FUNDROOM_PAYPAL_ME_GOODS_URL=
FUNDROOM_PAYPAL_MONTHLY_GOODS_URL=
FUNDROOM_PAYPAL_YEARLY_GOODS_URL=
ALPACA_LIVE_MAX_ORDER_USD=

