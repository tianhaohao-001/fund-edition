**/*.db-*
**/*.log
**/*.jsonl
**/*.wav
**/*.m4a
**/*.aac
**/*.mp3
**/*.mp4
**/*.pyc
**/*.zip
archive/
mobile/android/
mobile/ios/
mobile/dist*/
mobile/build/
mobile/.eas/
